MAX =5
stack=[None]*MAX
top=-1
def push(array_):
    global top
    if (top==MAX-1):
        print("stack is full")
    else:
        for i in array_:
            top+=1
            stack[top]=i
        print("Elements add in stack is succeesful..")
        print(stack)
def pop():
    global top
    if top==-1:
        print("stack is empty")
    else:
        item=stack[top]
        stack[top]=None
        top=top-1
        print(item,"poping operation is succesfull")
        print(stack)
def peek():
    global top
    if top==-1:
        print("stack is empty")
    else:
        print("Top element:",stack[-1])

def display():
    global top
    if top==-1:
        print("Stack is empty")
    else:
        for i in stack:
            print(i)

array_=[10,20,30,30,50]
push(array_)

display()

pop()
display()
