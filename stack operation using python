MAX =5
stack=[None]*MAX
top=-1
def push(item):
    global top
    if (top==MAX-1):
        print("stack is full")
    else:
        top+=1
        stack[top]=item
        print("element add in stack is succeesful..")
        print(stack)
def pop():
    global top
    if top==-1:
        print("stack is empty")
    else:
        item=stack[top]
        stack[top]==None
        top=top-1
        print(item,"poping operation is succesfull")

       

push(10)
push(20)
pop()
