MAX =5
stack=[None]*MAX
top=-1
def push():
    global top
    if (top==MAX-1):
        print("stack is full")
    else:
        n1=int(input("enter the number for push in stack:"))
        top+=1
        stack[top]=n1
        print("Elements add in stack is succeesful..")
        print(stack)
def pop():
    global top
    if top==-1:
        print("stack is empty")
    else:
        item=stack[top]
        stack[top]=None
        top=top-1
        print(item,"poping operation is succesfull")
        print(stack)
def peek():
    global top
    if top==-1:
        print("stack is empty")
    else:
        print("Top element:",stack[-1])

def display():
    global top
    if top==-1:
        print("Stack is empty")
    else:
        for i in stack:
            print(i)
while(True):

    print("welcome to stack implementaion!!!!!!")
    print("please select your operation:")
    print("1.push\n2.pop\n3.display\n4.exit")

    n=int(input("please enter your operation number:"))
    if n==1:
        push()
    elif n==2:
        pop()
    elif n==3:
        display()
    elif n==4:
        print("exit successfully")
        break
    s=input("if you want to continue or not:(yes or no):")
    if s.lower()=="yes":
        continue
    else:
        break












