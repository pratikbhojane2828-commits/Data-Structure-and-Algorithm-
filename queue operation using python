max=5
queue=[None]*max
front=-1
rear=-1
def enqueue():
    global front
    global rear
    if rear==max-1:
        print("queue is full")
    
    value=int(input("enter your value for insert:"))
    if(front==-1):
        front=0
    rear+=1
    queue[rear]=value
    print("insetion of element is succesfull")
   


def dequeue():
    global front
    global rear
    global queue
    if(front==-1 or front>rear):
        print("queue is underflow or empty")
        front=rear=-1

    print(f"{queue[front]} element is deleted")
    front+=1
    if(front>rear):
        rear=front=-1

def display():
    global front
    global rear
    if(front==-1):
        print("Queue is empty")
    else:
        print("queue element is=")
        for i in queue:
            print(i)
while(True):

    print("!!!!welcome in queue operation!!!")
